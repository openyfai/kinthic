# Gemini API Key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Model selection: gemini-2.5-flash (fast/cheap) or gemini-2.5-pro (deep reasoning)
ARIA_MODEL=gemini-2.5-flash

# Log level: DEBUG, INFO, WARNING, ERROR
ARIA_LOG_LEVEL=INFO

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_token_here

# Telegram Security — comma-separated list of authorized Telegram user IDs
# Get your ID by messaging @userinfobot on Telegram
# If empty AND TELEGRAM_PUBLIC_MODE is not true, the bot denies all access.
ALLOWED_TELEGRAM_USERS=

# Set to true to allow ANY Telegram user to interact with ARIA (NOT recommended)
# TELEGRAM_PUBLIC_MODE=false

# Web Visualizer — protects REST APIs and WebSocket chat when set.
# If empty, the web server only allows unauthenticated use on loopback binds.
# ARIA_WEB_API_KEY=
# ARIA_WEB_HOST=127.0.0.1
# ARIA_WEB_PORT=8000
# ARIA_WEB_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# ARIA_WS_MAX_MESSAGE_CHARS=2000000
# ARIA_WS_MAX_IMAGE_COUNT=4
# ARIA_WS_MAX_TOTAL_IMAGE_BYTES=10485760

# Granular autonomy policy. Keep these false unless you understand the risk.
# ARIA_ENABLE_TERMINAL_EXECUTION=false
# ARIA_ENABLE_CODE_APPLY=false
# ARIA_ENABLE_BROWSER_ACTIONS=true
# ARIA_ENABLE_BACKGROUND_LOOP=false
# ARIA_REQUIRE_TOOL_APPROVALS=true
# ARIA_MAX_TOOL_CALLS_PER_TURN=8

# Process role: standalone, web, telegram. Use one writer process per data dir.
# ARIA_PROCESS_ROLE=standalone

# Optional local model routing (OpenAI-compatible endpoint such as Ollama or llama.cpp server)
# ARIA_ENABLE_LOCAL_LLM=false
# ARIA_LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# ARIA_LOCAL_MODEL=local-aria
