# Runtime model selection. The web onboarding flow and `aria setup` write these
# to local settings files, but env vars still work for headless/server setups.
ARIA_PROVIDER=gemini
ARIA_MODEL=gemini-3.1-flash-lite
# ARIA_FAST_MODEL=gemini-3.1-flash-lite
# ARIA_REASONING_MODEL=gemini-3.1-pro

# Provider API keys. Only set the provider(s) you want to use.
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# MISTRAL_API_KEY=your_mistral_api_key_here
# GROQ_API_KEY=your_groq_api_key_here

# Log level: DEBUG, INFO, WARNING, ERROR
ARIA_LOG_LEVEL=INFO

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_token_here

# Telegram pairing. Preferred flow:
#   1. Run `kinthic telegram pair`
#   2. Send `/start CODE` or `/pair CODE` to your bot
# The legacy allowlist still works for headless deployments.
ALLOWED_TELEGRAM_USERS=

# Set to true to allow ANY Telegram user to interact with Kinthic (NOT recommended)
# TELEGRAM_PUBLIC_MODE=false

# Discord Bot Token (from Discord Developer Portal)
# DISCORD_BOT_TOKEN=your_discord_token_here
# ALLOWED_DISCORD_USERS=123456789012345678
# DISCORD_PUBLIC_MODE=false

# Granular autonomy policy. Keep these false unless you understand the risk.
# ARIA_ENABLE_TERMINAL_EXECUTION=false
# ARIA_ENABLE_CODE_APPLY=false
# ARIA_ENABLE_BROWSER_ACTIONS=true
# ARIA_ENABLE_BACKGROUND_LOOP=false
# ARIA_REQUIRE_TOOL_APPROVALS=true
# ARIA_MAX_TOOL_CALLS_PER_TURN=8

# Process role: standalone, web, telegram. Use one writer process per data dir
# unless you intentionally opt into shared-state risk.
# ARIA_PROCESS_ROLE=standalone
# ARIA_ALLOW_MULTI_WRITER=false

# Optional OpenAI-compatible local model routing (Ollama, llama.cpp, vLLM, etc.)
# ARIA_LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# ARIA_LOCAL_MODEL=llama3.1

# Optional semantic overlay: merged into the bundled ontology at startup (JSON, same schema as serialize()).
# Path: ./data/ontology.json (under the project DATA_DIR).
