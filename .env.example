# Gemini API Key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Model selection: gemini-2.5-flash (fast/cheap) or gemini-2.5-pro (deep reasoning)
ARIA_MODEL=gemini-2.5-flash

# Log level: DEBUG, INFO, WARNING, ERROR
ARIA_LOG_LEVEL=INFO

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_token_here

# Telegram Security — comma-separated list of authorized Telegram user IDs
# Get your ID by messaging @userinfobot on Telegram
# If empty AND TELEGRAM_PUBLIC_MODE is not true, the bot denies all access.
ALLOWED_TELEGRAM_USERS=

# Set to true to allow ANY Telegram user to interact with ARIA (NOT recommended)
# TELEGRAM_PUBLIC_MODE=false

# Web Visualizer — optional API key for /api/graph endpoint
# If empty, the server only binds to localhost (127.0.0.1)
# ARIA_WEB_API_KEY=
# ARIA_WEB_HOST=127.0.0.1
# ARIA_WEB_PORT=8000
