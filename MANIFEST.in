# 1. EXCLUDE PRIVATE DATA & WORKING DIRS
prune data
prune backups
prune workspace
prune scratch
prune audit_plan1
prune .cursor
prune build
prune dist

# 2. EXCLUDE INTERNAL DOCS & LAUNCH MATERIELS
prune docs

# 3. EXCLUDE PYTHON CACHED FILES
global-exclude __pycache__
global-exclude *.py[cod]

# 4. EXCLUDE ALL ROOT MARKDOWN FILES GLOBALLY (e.g. ARIA_*.md, phase plans, context.md)
exclude *.md

# 5. RE-INCLUDE ONLY THE OPEN SOURCE ESSENTIALS
include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include CODE_OF_CONDUCT.md
include LICENSE
include pyproject.toml

# 6. INCLUDE PLUGINS MANIFESTS & CONFIGS
recursive-include plugins *.yaml *.yml *.json
recursive-include silex *.yaml *.yml *.json
