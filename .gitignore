# Runtime data & secrets — never publish
data/
!data/.gitkeep
.env
.env.*
!.env.example
*.pem
*.p12
id_rsa*

# Builder-only & personal planning docs (keep on your machine only)
.cursor/
notes/

# IDE / assistant scratch (can contain project-specific prompts)
**/AGENTS.md
**/CLAUDE.md
.aria_pending_edits.json
backups/

# Workspace & ad-hoc experiments
scratch/
workspace/
test_screenshot.png

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Frontend — dependencies & build output (never push)
*/node_modules/
*/.next/
*/out/
*/dist/
*/huge*.txt

# Packaged web UI: only __init__.py is tracked; release CI copies Next export here
silex/web_dist/*
!silex/web_dist/__init__.py

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

audit_scratch/

# Environments
.venv/
venvTEST/
env/

# Databases
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
